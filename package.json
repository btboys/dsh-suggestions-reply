{
  "name": "dsh-suggestions-reply",
  "version": "0.1.6",
  "type": "module",
  "description": "Follow-up reply capsules below each completed answer and reusable message templates above the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btboys/dsh-suggestions-reply.git"
  },
  "homepage": "https://github.com/btboys/dsh-suggestions-reply#readme",
  "bugs": {
    "url": "https://github.com/btboys/dsh-suggestions-reply/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "suggestions",
    "reply",
    "templates"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "docs/screenshot.webp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
